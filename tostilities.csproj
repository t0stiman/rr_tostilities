<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>10</LangVersion>
		<WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>
		<PackageId>tostilities</PackageId>
		<RootNamespace>tostilities</RootNamespace>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Railroader -->
		<Reference Include="Railroader" />
		<Reference Include="Railroader.Modding" />

		<!-- Unity -->
		<Reference Include="UnityEngine.CoreModule" />
		<Reference Include="Unity.InputSystem" />
		
		<!-- Others-->
		<Reference Include="Serilog" />

		<!-- Nuget -->
		<PackageReference Include="Krafs.Publicizer" Version="2.2.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Lib.Harmony" Version="2.4.3" />

		<Publicize Include="Railroader" />
	</ItemGroup>
</Project>